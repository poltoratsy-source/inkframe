# Which engine drives the studio: "demo" (pre-rendered frames on a timer) or "real" (Claude writes, the painter draws).
INKFRAME_ENGINE=demo
# Demo speed multiplier: 1 = normal, 2 = twice as fast.
INKFRAME_DEMO_SPEED=1
# Optional. If empty, the real engine uses the Claude Code login on this computer (`claude -p`).
# The settings dialog in the app writes this line into .env.local; never commit that file.
ANTHROPIC_API_KEY=

# ---- real engine ----
# "template" = never ask Claude: template storyboard and rule-based scene edits.
INKFRAME_STORYBOARD=
# Seconds to wait for Claude before falling back to the template storyboard (default 150).
INKFRAME_CLAUDE_TIMEOUT=
# Optional Claude model for `claude -p --model` (e.g. sonnet).
INKFRAME_CLAUDE_MODEL=
# Chrome/Chromium for painting (found automatically if empty) and parallel painters (1-3, default 3).
CHROME_PATH=
INKFRAME_RENDER_WORKERS=
# 0 = use the GPU; by default Chrome paints in software (SwiftShader), which works on any server.
INKFRAME_SOFT_GL=
# 1 = full watercolour fills in the final cut (much slower: ~10-20 s a frame without a GPU).
INKFRAME_WATERCOLOR=
# Internal render scale of the final cut (default .5; .75 is sharper and ~2x slower).
INKFRAME_FINAL_RS=
# Where projects (drafts, clips, the MP4) are kept. Default: ./projects
INKFRAME_PROJECTS_DIR=
