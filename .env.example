# Which engine drives the studio: "demo" (stage 1, pre-rendered frames) or "real" (stage 2, Claude + renderer).
INKFRAME_ENGINE=demo
# Demo speed multiplier: 1 = normal, 2 = twice as fast.
INKFRAME_DEMO_SPEED=1
# Optional. If empty, the real engine (stage 2) will use your Claude Code login.
# The settings dialog in the app writes this line into .env.local; never commit that file.
ANTHROPIC_API_KEY=
