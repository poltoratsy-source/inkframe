{
  "name": "inkframe",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source studio for hand-painted cartoons, written and drawn by Claude",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H ${HOST:-127.0.0.1} -p ${PORT:-3700}",
    "build": "next build",
    "start": "next start -H ${HOST:-127.0.0.1} -p ${PORT:-3700}",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo:assets": "bash scripts/prepare-demo-assets.sh",
    "demo:record": "node scripts/record-walkthrough.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "preview:demo": "node scripts/serve-static.mjs out 3701"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
