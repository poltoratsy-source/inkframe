{
  "_about": "Inkframe design tokens, measured from Inkframe's own app/globals.css and components (not from OpenMontage). Roles map onto the existing @theme names; danger, warn and gate are new for the review and gate states. Check: python3 contrast.py tokens.json",
  "color": {
    "bg": "#14131a",
    "bg-deep": "#0f0e14",
    "surface": "#211f2b",
    "surface-2": "#262431",
    "surface-raised": "#2c2a37",
    "border": "#34313f",
    "border-input": "#77728a",
    "text": "#e9e6f0",
    "text-soft": "#c9c4d8",
    "text-muted": "#a9a4b8",
    "text-faint": "#8d88a0",
    "accent": "#ff8a3d",
    "accent-soft": "#ffb27d",
    "on-accent": "#1a1208",
    "success": "#9ff0b0",
    "success-bg": "#2f5d3a",
    "warn": "#f5c84c",
    "warn-bg": "#4a3b12",
    "danger": "#ff7a7a",
    "danger-bg": "#4d1f24",
    "gate": "#ffb27d",
    "gate-bg": "#3a2616",
    "voice": "#7f78c8",
    "music": "#4f8f7a"
  },
  "pairs": [
    ["text", "bg"], ["text", "surface"], ["text", "surface-2"], ["text", "surface-raised"],
    ["text-soft", "surface"], ["text-muted", "bg"], ["text-muted", "surface"], ["text-muted", "surface-2"],
    ["text-faint", "bg"], ["text-faint", "surface"],
    ["on-accent", "accent"], ["on-accent", "accent-soft"], ["accent", "bg"], ["accent", "surface"],
    ["success", "success-bg"], ["success", "surface"], ["warn", "warn-bg"], ["warn", "surface"],
    ["danger", "danger-bg"], ["danger", "surface"], ["gate", "gate-bg"], ["text", "gate-bg"],
    ["border-input", "bg", "ui"], ["border-input", "surface", "ui"], ["accent", "surface", "ui"]
  ],
  "font": {
    "sans": "Inter, 'DejaVu Sans', system-ui, sans-serif",
    "hand": "Caveat (renderer only, OFL, renderer/fonts)",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": {
    "micro": {"size": 11, "line": 14, "weight": 600},
    "xs": {"size": 12, "line": 16, "weight": 500},
    "sm": {"size": 13, "line": 18, "weight": 400},
    "base": {"size": 14, "line": 20, "weight": 400},
    "lg": {"size": 18, "line": 24, "weight": 700},
    "xl": {"size": 22, "line": 28, "weight": 700}
  },
  "space": [0, 2, 4, 6, 8, 10, 12, 16, 20, 24, 32],
  "radius": {"sm": 6, "md": 8, "lg": 10, "xl": 12, "2xl": 16, "pill": 999},
  "shadow": {
    "pop": "0 16px 40px rgba(0,0,0,.45)",
    "pen": "0 0 18px #ff8a3d"
  },
  "motion": {"fast": "120ms", "base": "200ms", "reveal": "700ms", "ease": "cubic-bezier(.2,.8,.2,1)"},
  "layout": {"topbar": 56, "worklog": 330, "editpanel": 320, "minHeight": 760}
}
